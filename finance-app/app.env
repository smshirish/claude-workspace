# Single source of truth for the web app port.
# Read by: application.yml (spring.config.import; port and mapping file), bin/stop.sh, e2e/playwright.config.ts,
# tools/screenshots/capture.mjs
APP_PORT=8080

# Anonymisation mapping written by tools/csv-converter (ANON-XXXX -> real account number)
MAPPING_FILE=/tmp/anonym_to_real_id.json
