{
  "permissions": {
    "deny": [
      "Edit(src/**)",
      "Write(src/**)",
      "Edit(e2e/**)",
      "Write(e2e/**)",
      "Bash(mvn spring-boot:run*)",
      "Bash(npx *)",
      "Bash(git commit*)",
      "Bash(git push*)",
      "Bash(git merge*)"
    ],
    "allow": [
      "Bash(git diff*)",
      "Bash(git log*)",
      "Bash(git show*)"
    ],
    "defaultMode": "acceptEdits"
  }
}
