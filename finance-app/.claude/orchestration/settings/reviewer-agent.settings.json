{
  "permissions": {
    "deny": [
      "Bash(git commit*)",
      "Bash(git merge*)",
      "Bash(git push *)",
      "Bash(git push*)",
      "Bash(mvn spring-boot:run*)",
      "Bash(npx *)",
      "Edit(e2e/**)",
      "Edit(src/**)",
      "Read(**/*secrets*.env)",
      "Read(**/RealToAnonymIds.json)",
      "Read(**/anonym_to_real_id.json)",
      "Read(**/e2e/data/accounts_v1.csv)",
      "Read(**/local/**)",
      "Write(e2e/**)",
      "Write(src/**)"
    ],
    "allow": [
      "Bash(git diff*)",
      "Bash(git log*)",
      "Bash(git show*)"
    ],
    "defaultMode": "acceptEdits"
  }
}
