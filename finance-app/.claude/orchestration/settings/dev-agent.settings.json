{
  "permissions": {
    "deny": [
      "Edit(src/test/**)",
      "Write(src/test/**)",
      "Edit(e2e/**)",
      "Write(e2e/**)",
      "Bash(git commit*)",
      "Bash(git push*)",
      "Bash(git merge*)"
    ],
    "allow": [
      "Bash(mvn test*)",
      "Bash(mvn compile*)",
      "Bash(mvn clean compile*)"
    ],
    "defaultMode": "acceptEdits"
  }
}
