{
  "permissions": {
    "deny": [
      "Edit(src/test/**)",
      "Write(src/test/**)",
      "Edit(e2e/**)",
      "Write(e2e/**)",
      "Bash(git commit*)",
      "Bash(git push*)",
      "Bash(git merge*)"
    ],
    "allow": [
      "Bash(mvn test*)",
      "Bash(mvn compile*)",
      "Bash(mvn clean compile*)",
      "Bash(bin/start.sh*)",
      "Bash(source bin/env.sh*)",
      "Bash(cd e2e && npx *)",
      "Bash(npx playwright*)",
      "Bash(curl *localhost*)",
      "Bash(sleep *)",
      "Bash(lsof *)",
      "Bash(kill *)",
      "Bash(pkill *)"
    ],
    "defaultMode": "acceptEdits"
  }
}
