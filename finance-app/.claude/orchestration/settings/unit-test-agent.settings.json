{
  "permissions": {
    "deny": [
      "Edit(src/main/**)",
      "Write(src/main/**)",
      "Edit(e2e/**)",
      "Write(e2e/**)",
      "Bash(mvn spring-boot:run*)",
      "Bash(git commit*)",
      "Bash(git push*)",
      "Bash(git merge*)"
    ],
    "allow": [
      "Bash(mvn test*)",
      "Bash(mvn test-compile*)",
      "Bash(mvn clean compile*)",
      "Write(.claude/context/RESULT.json)"
    ],
    "defaultMode": "acceptEdits"
  }
}
