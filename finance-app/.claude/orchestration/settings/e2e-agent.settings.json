{
  "permissions": {
    "deny": [
      "Bash(git commit*)",
      "Bash(git merge*)",
      "Bash(git push *)",
      "Bash(git push*)",
      "Edit(src/main/**)",
      "Edit(src/test/**)",
      "Read(**/*secrets*.env)",
      "Read(**/RealToAnonymIds.json)",
      "Read(**/anonym_to_real_id.json)",
      "Read(**/e2e/data/accounts_v1.csv)",
      "Read(**/local/**)",
      "Write(src/main/**)",
      "Write(src/test/**)"
    ],
    "allow": [
      "Bash(mvn spring-boot:run*)",
      "Bash(cd e2e && npx *)",
      "Bash(npx playwright*)",
      "Bash(curl *localhost*)",
      "Bash(sleep *)",
      "Bash(lsof *)",
      "Bash(kill *)",
      "Bash(pkill *)"
    ],
    "defaultMode": "acceptEdits"
  }
}
