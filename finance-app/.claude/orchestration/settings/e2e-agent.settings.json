{
  "permissions": {
    "deny": [
      "Edit(src/main/**)",
      "Write(src/main/**)",
      "Edit(src/test/**)",
      "Write(src/test/**)",
      "Bash(git commit*)",
      "Bash(git push*)",
      "Bash(git merge*)"
    ],
    "allow": [
      "Bash(mvn spring-boot:run*)",
      "Bash(cd e2e && npx *)",
      "Bash(npx playwright*)",
      "Bash(curl *localhost*)",
      "Bash(sleep *)",
      "Bash(lsof *)",
      "Bash(kill *)",
      "Bash(pkill *)",
      "Write(.claude/context/RESULT.json)"
    ],
    "defaultMode": "acceptEdits"
  }
}
