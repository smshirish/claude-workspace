# Pinned model per pipeline role. Sourced by orchestrate.sh.
# Bump deliberately (one commit) — the COST_<Feature>.md table records which model ran.
# Any value can be overridden from the environment, e.g. DEV_MODEL=claude-opus-5-5 orchestrate.sh X
#
# Opus for spec + reviewer: plan clarity and review quality drive the expensive
# loops (review rounds, escalations); both are low-volume calls.
SPEC_MODEL="${SPEC_MODEL:-claude-opus-5-5}"
UNIT_TEST_MODEL="${UNIT_TEST_MODEL:-claude-sonnet-5-5}"
DEV_MODEL="${DEV_MODEL:-claude-sonnet-5-5}"
REVIEWER_MODEL="${REVIEWER_MODEL:-claude-opus-5-5}"
E2E_MODEL="${E2E_MODEL:-claude-sonnet-5-5}"
