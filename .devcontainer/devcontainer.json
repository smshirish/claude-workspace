{
  "name": "Claude Code Development",
  "image": "mcr.microsoft.com/devcontainers/javascript-node:20", 
  "features": {
    // Recommended to explicitly include Node.js to ensure compatibility [2]
    "ghcr.io/devcontainers/features/node:1": {},
    // Official Anthropic feature to install Claude Code CLI globally [1, 3]
    "ghcr.io/anthropics/devcontainer-features/claude-code:1": {}
  },
  "customizations": {
    "vscode": {
      "extensions": [
        // Recommended extension for working with Claude Code [1]
        "anthropic.claude-code"
      ]
    }
  },
  // Ensure the container runs as the 'node' user provided by the base image [4]
  "remoteUser": "node",
  "forwardPorts": [8080],
   "runArgs": [
    "--cap-add=NET_ADMIN",
    "--cap-add=NET_RAW"
  ],
  "postCreateCommand": [
    //"claude plugin marketplace add VoltAgent/awesome-claude-code-subagents" // Marketplace for claude sub agents ,not working, ran manually from command line in termminal
    //claude plugin install voltagent-lang ,claude plugin install voltagent-qa-sec ,claude plugin install voltagent-core-dev
    // sudo apt install maven
    //sudo apt-get install -y openjdk-21-jdk-headless
    //set java home in bashrc export JAVA_HOME=/usr/lib/jvm/java-21-openjdk-amd64' >> ~/.bashrc
    "bash",
    "-c",
    "sudo apt-get update && sudo apt-get install -y openjdk-21-jdk-headless maven && echo 'export JAVA_HOME=/usr/lib/jvm/java-21-openjdk-amd64' >> ~/.bashrc"
	]
}